---
import '../styles/global.css';
import { SITE } from '../data/site.mjs';

const {
  title = 'Scrobble.dev — a field guide to scrobbling',
  description = 'Plain-language guidance for recording, correcting, exchanging and preserving media activity.',
  canonical = Astro.url.pathname,
  type = 'WebPage',
  schema = [],
  markdown,
  status,
  modified
} = Astro.props;

const canonicalUrl = new URL(canonical, Astro.site ?? 'https://scrobble.dev');
const pathname = Astro.url.pathname;
const releaseCommit = process.env.SCROBBLE_RELEASE_SHA || process.env.GITHUB_SHA || 'development';
const baseSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': 'https://scrobble.dev/#website',
    url: 'https://scrobble.dev/',
    name: 'Scrobble.dev',
    description: SITE.description,
    inLanguage: 'en'
  },
  {
    '@context': 'https://schema.org',
    '@type': type,
    '@id': `${canonicalUrl.href}#page`,
    url: canonicalUrl.href,
    name: title,
    description,
    isPartOf: { '@id': 'https://scrobble.dev/#website' },
    inLanguage: 'en',
    ...(modified ? { dateModified: modified } : {})
  },
  ...schema
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f4f0e7" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <meta name="source-commit" content={releaseCommit} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM index" />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Scrobble.dev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    {baseSchema.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" id="top">
      <div class="shell masthead">
        <a class="wordmark" href="/" aria-label="Scrobble.dev home">scrobble.dev</a>
        <p>A field guide to media tracking</p>
      </div>
      <nav class="shell nav desktop-nav" aria-label="Primary navigation">
        {SITE.primaryNavigation.map((item) => (
          <a href={item.href} aria-current={item.match.some((prefix) => pathname.startsWith(prefix)) ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
      <details class="site-menu">
        <summary class="shell">Menu</summary>
        <nav class="shell mobile-nav" aria-label="Primary navigation, small screens">
          {SITE.primaryNavigation.map((item) => (
            <a href={item.href} aria-current={item.match.some((prefix) => pathname.startsWith(prefix)) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
      </details>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer h-card">
      <div class="shell footer-grid">
        <div>
          <a class="wordmark p-name u-url" href="https://scrobble.dev/">scrobble.dev</a>
          <p class="p-note">{SITE.description}</p>
        </div>
        {SITE.footerSections.map((section) => (
          <nav aria-label={section.label}>
            <p>{section.label}</p>
            {section.links.map((link) => <a href={link.href}>{link.label}</a>)}
          </nav>
        ))}
      </div>
      <div class="shell footer-bottom">
        <nav class="footer-actions" aria-label="Contribution links">
          <span>Contribute</span>
          {SITE.footerActions.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
        {(status || modified) && (
          <p class="footer-page-meta">
            {status && <span>Status: {status}</span>}
            {modified && <span>Updated <time datetime={modified}>{modified}</time></span>}
          </p>
        )}
      </div>
    </footer>
  </body>
</html>
