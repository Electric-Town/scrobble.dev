---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Draft scrobbling principles — Scrobble.dev';
const description = 'Scrobble.dev discussion-draft principles for portable media activity, provenance, safe retry, correction and export.';
const principles = [
  ['Keep different records distinct', 'A temporary observation, durable event, progress state, completion decision, rating, list entry and collection item have different jobs.'],
  ['Preserve the media context the source knew', 'Keep source-local identity and item grain instead of silently replacing the record with a preferred provider.'],
  ['Name each time', 'Playback start, completion, diary date, import time and receipt time answer different questions.'],
  ['Keep native progress', 'Seconds, pages, chapters, episodes, sessions and turns remain available before a percentage is derived.'],
  ['Record provenance', 'Manual entries, player telemetry, imports, webhooks, corrections and synchronized copies carry different evidence.'],
  ['Make retry harmless', 'Receiving the same logical event again must not manufacture another history entry.'],
  ['Support correction and removal', 'A person must be able to fix a wrong item, time or duplicate and remove history they do not want retained.'],
  ['Design export with the record', 'A documented export and its known losses are part of correctness, not a later courtesy.']
];
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: 'Draft scrobbling principles',
  description,
  dateModified: '2026-08-11',
  version: '0.1-discussion-draft',
  author: { '@type': 'Organization', name: 'Scrobble.dev' }
}];
---
<BaseLayout {title} {description} type="TechArticle" schema={schema} markdown="/knowledge/concepts/interoperability.md" modified="2026-08-11" status="discussion draft 0.1">
  <article class="shell section article">
    <div class="article-body">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Field guide</a><span aria-hidden="true">/</span><span aria-current="page">Draft profiles</span></nav>
      <p class="kicker">Scrobble.dev discussion draft 0.1</p>
      <h1>Eight draft principles for exchanging scrobble data.</h1>
      <p class="standfirst">Scrobble.dev publishes these principles for testing and comment. They are not an adopted industry standard, and no implementation is required to use them.</p>
      <dl class="principles-list">
        {principles.map(([name, detail], index) => <div><dt><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>{name}</dt><dd>{detail}</dd></div>)}
      </dl>
      <h2>Privacy limits the exchange</h2>
      <p>Media history can expose habits and routines. A format cannot enforce consent by naming a visibility field. Implementations remain responsible for authorization, retention, deletion and preventing one person's history from reaching another account.</p>
      <h2>What this draft does not define</h2>
      <p>It does not define authentication, a universal completion threshold, one provider identity, a transport protocol or conformance. Those subjects require governance, a processing model, security analysis, fixtures and independent implementation before stronger claims are appropriate.</p>
      <p class="contribution-note">Add a documented failure case or comment through <a href="https://github.com/Electric-Town/scrobble.dev/issues/new">Scrobble.dev</a>. Reproduce implementation behaviour through <a href="https://github.com/dannyvfilms/Floppy/issues">Floppy issues</a>.</p>
    </div>
  </article>
</BaseLayout>
