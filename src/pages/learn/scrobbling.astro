  '@context':'https://schema.org','@type':'DefinedTerm',name:'Scrobbling',description:'Recording media consumption events and progress so a user can preserve and synchronize a media history.',inDefinedTermSet:'https://scrobble.dev/#scrobbling-knowledge'
