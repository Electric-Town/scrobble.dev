const description='A practical definition and history of scrobbling, how scrobble events work, and how tracking differs across movies, TV, anime, books, manga, comics, games, music, podcasts, and board games.';
const schema=[{
  '@context':'https://schema.org','@type':'TechArticle',headline:'What is scrobbling?',description,dateModified:'2026-08-11',author:{'@type':'Organization',name:'Scrobble.dev'},mainEntityOfPage:'https://scrobble.dev/learn/scrobbling/'
