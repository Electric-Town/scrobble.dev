---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Floppy implementation notes — Scrobble.dev';
const description = 'How Scrobble.dev uses Floppy and FloppyDesktop to test media-history guidance without defining scrobbling through one product.';
const schema = [{ '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Floppy', description: 'Self-hosted media tracking and scrobbling application.', applicationCategory: 'Media tracking', codeRepository: 'https://github.com/dannyvfilms/Floppy', license: 'https://www.gnu.org/licenses/agpl-3.0.html' }];
---
<BaseLayout {title} {description} type="WebPage" schema={schema} modified="2026-08-11" status="stable">
  <article class="shell section article">
    <div class="article-body">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Field guide</a><span aria-hidden="true">/</span><a href="/projects/">Projects</a><span aria-hidden="true">/</span><span aria-current="page">Floppy</span></nav>
      <p class="kicker">Implementation used for testing</p>
      <h1>Floppy exposes real cross-media tracking cases.</h1>
      <p class="standfirst">Scrobble.dev uses Floppy and FloppyDesktop to test draft guidance against imports, progress, history, correction and export. They do not define scrobbling for other projects.</p>

      <h2>Documented scope</h2>
      <table class="faq-table">
        <tbody>
          <tr><th scope="row">Media</th><td>Film, television, anime, books, manga, comics, music, podcasts, video games and board games.</td></tr>
          <tr><th scope="row">Record</th><td>Library, progress, history, statistics, lists and collections.</td></tr>
          <tr><th scope="row">Deployment</th><td>Self-hosted web application with a native desktop client.</td></tr>
          <tr><th scope="row">Licence</th><td>AGPL-3.0 for the linked repositories.</td></tr>
          <tr><th scope="row">Checked</th><td>11 August 2026 against the project repositories.</td></tr>
        </tbody>
      </table>

      <h2>A useful contribution case</h2>
      <p>Name the medium, the event sequence, the record produced and the record expected. Include source-local media context, event time, native progress and whether an ordinary retry created a duplicate. Remove private account and viewing data.</p>

      <p class="project-links"><a class="button primary" href="https://github.com/dannyvfilms/Floppy">Open Floppy</a><a href="https://github.com/dannyvfilms/Floppy/issues">Work on Floppy</a><a href="https://github.com/sponsors/dannyvfilms">Sponsor Danny's Floppy work</a><a href="https://github.com/Electric-Town/FloppyDesktop">Open FloppyDesktop</a></p>
    </div>
  </article>
</BaseLayout>
