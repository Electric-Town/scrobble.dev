---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROJECTS } from '../data/projects.mjs';

const lifecycle = [
  ['Now playing', 'A temporary statement about what a player is handling now.', 'May disappear without entering history.'],
  ['Progress', 'A position such as seconds, pages, chapters or turns.', 'Can change many times during one session.'],
  ['Scrobble', 'A durable, time-stamped record of media activity.', 'Belongs in history and must support correction.'],
  ['Completion', 'A decision that a work or defined unit is finished.', 'Uses a policy appropriate to the medium and source.']
];

const mediaGroups = [
  ['Listening', 'Music and podcasts use time, duration, recordings, releases, episodes and feeds.'],
  ['Watching', 'Film, television and anime need work, release, season, episode and order context.'],
  ['Reading', 'Books, manga and comics use editions, volumes, chapters, issues and pages.'],
  ['Playing', 'Video and board games may use sessions, platforms, turns, scores and completion states.']
];

const schema = [{
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  '@id': 'https://scrobble.dev/#terms',
  name: 'Scrobbling terms',
  url: 'https://scrobble.dev/#definition',
  inLanguage: 'en',
  hasDefinedTerm: [
    { '@type': 'DefinedTerm', name: 'Scrobble', description: 'A durable, time-stamped record that someone listened to, watched, read or played a specific piece of media.', url: 'https://scrobble.dev/#definition' },
    { '@type': 'DefinedTerm', name: 'Now playing', description: 'A temporary statement about media being handled by a player now.', url: 'https://scrobble.dev/#lifecycle' }
  ]
}];
---
<BaseLayout schema={schema} markdown="/knowledge/concepts/scrobbling.md" modified="2026-08-11" status="stable">
  <section class="shell home-hero" id="definition" aria-labelledby="hero-title">
    <div>
      <p class="kicker">Scrobbling, in plain language</p>
      <h1 id="hero-title">A scrobble is a durable record of something watched, read, listened to or played.</h1>
      <p class="standfirst">It identifies the media and records when the activity happened. It may also preserve progress, completion and how the event was observed.</p>
      <p>For example, a music player can record that a track was played at 19:42. A reading tracker can record that a chapter was finished. Those records can form a history that survives a change of app.</p>
      <div class="actions">
        <a class="button primary" href="/learn/">I use trackers</a>
        <a class="button" href="/build/">I build trackers</a>
      </div>
    </div>
    <aside class="hero-brief" aria-labelledby="brief-title">
      <p class="brief-label" id="brief-title">A useful record answers</p>
      <dl>
        <div><dt>What</dt><dd>the media that was consumed</dd></div>
        <div><dt>When</dt><dd>the time represented by the event</dd></div>
        <div><dt>How far</dt><dd>the medium's own progress, when known</dd></div>
        <div><dt>How known</dt><dd>manual entry, player, import or sync</dd></div>
      </dl>
    </aside>
  </section>

  <section class="definition-band" aria-labelledby="paths-title">
    <div class="shell article-grid">
      <p class="section-label">Choose a path</p>
      <div>
        <h2 id="paths-title">Learn the record, or build the exchange.</h2>
        <div class="path-list">
          <article><h3>Using trackers</h3><p>Understand histories, privacy, corrections, exports and the differences between projects.</p><a href="/learn/">Start with the field guide</a></article>
          <article><h3>Building trackers</h3><p>Keep event time, identity, native progress and provenance clear enough to retry, export and correct.</p><a href="/build/">Read the implementation guide</a></article>
        </div>
      </div>
    </div>
  </section>

  <section class="shell section" id="lifecycle" aria-labelledby="lifecycle-title">
    <div class="section-intro">
      <p class="section-label">The activity lifecycle</p>
      <h2 id="lifecycle-title">Playing now, progress, history and completion are different records.</h2>
      <p>A tracker can connect them without treating a temporary player state as durable history.</p>
    </div>
    <div class="measure-table" role="table" aria-label="Media activity lifecycle">
      <div class="measure-row measure-head" role="row"><span role="columnheader">Record</span><span role="columnheader">Meaning</span><span role="columnheader">Boundary</span></div>
      {lifecycle.map(([record, meaning, boundary]) => <div class="measure-row" role="row"><strong role="cell">{record}</strong><span role="cell">{meaning}</span><span role="cell">{boundary}</span></div>)}
    </div>
    <p><a href="/learn/lifecycle/">Read the lifecycle guide</a>.</p>
  </section>

  <section class="measure-band" aria-labelledby="media-title">
    <div class="shell section">
      <div class="section-intro">
        <p class="section-label">Across media</p>
        <h2 id="media-title">Progress keeps the unit that the medium actually uses.</h2>
        <p>A percentage can be a useful display, but it should not replace the pages, seconds, chapters, episodes, sessions or turns that produced it.</p>
      </div>
      <dl class="media-groups">
        {mediaGroups.map(([group, detail]) => <div><dt>{group}</dt><dd>{detail}</dd></div>)}
      </dl>
      <p>Scrobble.dev's <a href="/standard/">draft principles</a> propose clear timestamps, source-local identity, native progress, provenance, safe retry, correction and export. They are published for testing and comment, not as an adopted industry standard.</p>
    </div>
  </section>

  <section class="shell section" id="projects" aria-labelledby="projects-title">
    <div class="section-intro">
      <p class="section-label">Projects and participation</p>
      <h2 id="projects-title">Compare the field, then improve the record.</h2>
      <p>The catalogue describes {PROJECTS.length} services, trackers, clients and connectors from their own documentation or repositories. It does not rank them.</p>
    </div>
    <div class="project-actions">
      <a class="button primary" href="/projects/">Open the project catalogue</a>
      <a href="https://github.com/Electric-Town/scrobble.dev/issues/new">Correct the field guide</a>
      <a href="https://github.com/dannyvfilms/Floppy/issues">Contribute a tracking case to Floppy</a>
    </div>
    <p class="reference-note">Floppy and FloppyDesktop are software projects used to test the guidance. They remain available from the footer without defining scrobbling for the rest of the field.</p>
  </section>
</BaseLayout>
